{
	"$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
	"files": {
		"includes": ["src/**/*"]
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"indentScriptAndStyle": true
		}
	},
	"formatter": {
		"enabled": true,
		"indentWidth": 2,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"globals": ["Astro"],
		"formatter": {
			"quoteProperties": "asNeeded",
			"jsxQuoteStyle": "single",
			"quoteStyle": "single",
			"bracketSpacing": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"style": {
						"useConst": "off",
						"useImportType": "off"
					},
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					},
					"suspicious": {
						"noUnknownAtRules": "warn",
						"noImplicitAnyLet": "warn"
					}
				}
			}
		}
	]
}
